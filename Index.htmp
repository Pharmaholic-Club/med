<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no">
<title>ตะกร้าแยกยา ให้ถูก</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Sarabun:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --room-a:#cfe9f7;
    --room-b:#eaf6ff;
    --floor:#e9c99a;
    --red-a:#f0685a;
    --red-b:#c73a2f;
    --green-a:#7bc465;
    --green-b:#438033;
    --ink:#2c3e42;
    --blue:#2f7ed1;
    --blue-dark:#1f5fac;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{height:100%;}
  body{
    margin:0;
    font-family:'Sarabun', sans-serif;
    background:#dfeaf0;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:14px;
    color:var(--ink);
    overflow:hidden;
  }

  .stage{
    position:relative;
    width:100%;
    max-width:900px;
    aspect-ratio:5/4;
    border-radius:26px;
    overflow:hidden;
    box-shadow:0 18px 40px rgba(20,50,60,.25);
    background:
      linear-gradient(var(--room-a), var(--room-b)) 0 0/100% 68% no-repeat,
      linear-gradient(var(--floor), #d9b077) 0 68%/100% 32% no-repeat;
    display:flex;
    flex-direction:column;
    user-select:none;
  }

  /* faux shelving decoration */
  .shelf{
    position:absolute;
    right:0; top:0;
    width:26%;
    height:60%;
    background:
      repeating-linear-gradient(180deg, transparent 0 22%, rgba(140,110,70,.35) 22% 23%, transparent 23% 25%),
      linear-gradient(180deg, rgba(230,215,190,.55), rgba(230,215,190,.15));
    border-left:3px solid rgba(140,110,70,.25);
    opacity:.7;
  }
  .shelf .bottle{
    position:absolute;
    width:14px;height:22px;
    border-radius:4px 4px 2px 2px;
  }

  /* header */
  .headbar{
    margin:14px 16px 8px;
    background:#fff;
    border:3px solid var(--blue);
    border-radius:999px;
    display:flex;
    align-items:center;
    gap:10px;
    padding:6px 18px 6px 6px;
    box-shadow:0 6px 14px rgba(0,0,0,.12);
    z-index:3;
  }
  .avatar{
    flex:none;
    width:46px;height:46px;
    border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #ffe1c4, #ffc98f);
    display:flex;align-items:center;justify-content:center;
    font-size:26px;
    box-shadow:inset 0 -3px 6px rgba(0,0,0,.08);
  }
  .headbar h1{
    font-family:'Baloo 2', sans-serif;
    font-size:clamp(15px,3vw,20px);
    margin:0;
    flex:1;
    font-weight:700;
    color:#20507a;
  }
  .headbar .icons{font-size:22px;flex:none;}

  .instruction{
    margin:0 20px 10px;
    background:#fff;
    border-radius:14px;
    text-align:center;
    padding:8px 14px;
    font-size:clamp(13px,2.6vw,16px);
    font-weight:600;
    color:#3a5a70;
    box-shadow:0 4px 10px rgba(0,0,0,.08);
    z-index:3;
  }

  .playarea{
    position:relative;
    flex:1;
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    padding:0 5% 4%;
    z-index:2;
  }

  /* bins */
  .binwrap{
    position:relative;
    width:30%;
    display:flex;
    flex-direction:column;
    align-items:center;
  }
  .bubble{
    background:#fff;
    border-radius:16px;
    padding:8px 12px;
    font-size:clamp(11px,2.1vw,14px);
    font-weight:700;
    text-align:center;
    line-height:1.35;
    box-shadow:0 4px 8px rgba(0,0,0,.1);
    margin-bottom:6px;
    position:relative;
    max-width:180px;
  }
  .bubble.red{color:var(--red-b);}
  .bubble.green{color:var(--green-b);}
  .bubble:after{
    content:"";
    position:absolute;
    bottom:-8px;left:50%;
    transform:translateX(-50%);
    border-width:8px 7px 0 7px;
    border-style:solid;
    border-color:#fff transparent transparent transparent;
  }
  .bin{
    width:100%;
    max-width:230px;
    transition:transform .12s ease, filter .12s ease;
    filter:drop-shadow(0 10px 10px rgba(0,0,0,.2));
  }
  .binwrap.hover .bin{transform:scale(1.06) translateY(-4px);}
  .binlabel{
    position:absolute;
    bottom:22%;
    left:50%;
    transform:translateX(-50%);
    color:#fff;
    font-weight:700;
    font-family:'Baloo 2',sans-serif;
    text-align:center;
    font-size:clamp(10px,1.9vw,13px);
    text-shadow:0 2px 3px rgba(0,0,0,.35);
    line-height:1.3;
    width:80%;
    pointer-events:none;
  }

  /* center column */
  .centercol{
    width:32%;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:14px;
    position:relative;
  }

  .card{
    width:150px;
    background:#fff;
    border-radius:16px;
    border:3px solid #f4c9d6;
    box-shadow:0 10px 18px rgba(0,0,0,.18);
    padding:10px;
    text-align:center;
    touch-action:none;
    cursor:grab;
    position:relative;
    z-index:5;
  }
  .card.armed{
    border-color:#f4a63d;
    box-shadow:0 0 0 4px rgba(244,166,61,.3), 0 10px 18px rgba(0,0,0,.18);
  }
  .card.dragging{cursor:grabbing;filter:drop-shadow(0 14px 14px rgba(0,0,0,.3));}
  .card .blister{
    width:100%;
    height:78px;
    border-radius:10px;
    background:linear-gradient(160deg,#dfe6ee,#c7d0da);
    display:grid;
    grid-template-columns:repeat(4,1fr);
    grid-template-rows:repeat(2,1fr);
    gap:4px;
    padding:8px;
    margin-bottom:8px;
  }
  .card .blister span{
    background:radial-gradient(circle at 35% 30%, #ffb9c9, #e8748f);
    border-radius:50%;
    box-shadow:inset -2px -2px 3px rgba(0,0,0,.15);
  }
  .card .name{
    font-size:13px;
    font-weight:700;
    color:#3a4650;
    line-height:1.3;
  }
  .card .namesub{
    font-size:11px;
    font-weight:500;
    color:#7a8791;
    margin-top:2px;
  }

  .deck{
    position:relative;
    width:120px;
    height:96px;
    cursor:pointer;
  }
  .deck .layer{
    position:absolute;
    inset:0;
    background:linear-gradient(160deg, var(--blue), var(--blue-dark));
    border-radius:12px;
    box-shadow:0 6px 10px rgba(0,0,0,.18);
  }
  .deck .layer:nth-child(1){transform:translate(4px,4px) rotate(-4deg);}
  .deck .layer:nth-child(2){transform:translate(2px,2px) rotate(2deg);}
  .deck .layer:nth-child(3){
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-family:'Baloo 2',sans-serif;font-weight:700;
    font-size:15px;
  }

  /* footer */
  .footer{
    margin:0 18px 16px;
    background:rgba(255,255,255,.92);
    border-radius:16px;
    padding:10px 16px;
    display:flex;
    align-items:center;
    gap:14px;
    box-shadow:0 6px 14px rgba(0,0,0,.12);
    z-index:3;
  }
  .nextbtn{
    background:linear-gradient(180deg, var(--blue), var(--blue-dark));
    color:#fff;
    border:none;
    border-radius:12px;
    padding:10px 18px;
    font-family:'Baloo 2',sans-serif;
    font-weight:700;
    font-size:14px;
    cursor:pointer;
    box-shadow:0 4px 0 #16467f;
  }
  .nextbtn:active{transform:translateY(2px);box-shadow:0 2px 0 #16467f;}
  .scoretext{
    font-weight:700;
    font-size:14px;
    color:#2c3e42;
    flex:none;
  }
  .progress{
    flex:1;
    height:14px;
    background:#2c3e42;
    border-radius:999px;
    overflow:hidden;
  }
  .progress-fill{
    height:100%;
    width:0%;
    background:linear-gradient(90deg,#8fd66a,#4fae3d);
    border-radius:999px;
    transition:width .3s ease;
  }

  /* feedback flash */
  .flash{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:'Baloo 2',sans-serif;
    font-size:54px;
    font-weight:800;
    opacity:0;
    pointer-events:none;
    z-index:20;
  }
  .flash.show{animation:flashpop .55s ease forwards;}
  .flash.correct{color:#3f8f30;}
  .flash.wrong{color:#c23a2f;}
  @keyframes flashpop{
    0%{opacity:0;transform:scale(.5);}
    30%{opacity:1;transform:scale(1.15);}
    60%{opacity:1;transform:scale(1);}
    100%{opacity:0;transform:scale(1);}
  }

  .complete{
    position:absolute;
    inset:0;
    background:rgba(20,40,50,.55);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:30;
    text-align:center;
    padding:20px;
  }
  .complete.show{display:flex;}
  .complete-card{
    background:#fff;
    border-radius:18px;
    padding:26px 24px;
    max-width:320px;
  }
  .complete-card h2{
    font-family:'Baloo 2',sans-serif;
    margin:0 0 8px;
    color:#20507a;
    font-size:20px;
  }
  .complete-card p{
    margin:0 0 16px;
    font-size:14px;
    color:#4a5c66;
    line-height:1.6;
  }
  .complete-card button{
    background:linear-gradient(180deg, var(--blue), var(--blue-dark));
    color:#fff;border:none;border-radius:12px;
    padding:10px 20px;font-family:'Baloo 2',sans-serif;font-weight:700;
    font-size:14px;cursor:pointer;
  }
</style>
</head>
<body>

<div class="stage" id="stage">
  <div class="shelf"></div>

  <div class="headbar">
    <div class="avatar">🧑‍⚕️</div>
    <h1>Sort the Medicine Basket (ตะกร้าแยกยา ให้ถูก)</h1>
    <div class="icons">💊🧴</div>
  </div>

  <div class="instruction">Drag the medicine card into the correct basket! (ลากการ์ดยาไปวางในตะกร้าที่ถูกต้อง!)</div>

  <div class="playarea" id="playarea">

    <div class="binwrap" id="binRed" data-type="antibiotic">
      <div class="bubble red">Antibiotics – Use as Directed<br>(ยาปฏิชีวนะ – ใช้ตามคำแนะนำ)</div>
      <div style="position:relative;width:100%;">
        <svg class="bin" viewBox="0 0 220 200">
          <defs>
            <linearGradient id="redBody" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="var(--red-a)"/>
              <stop offset="1" stop-color="var(--red-b)"/>
            </linearGradient>
          </defs>
          <path d="M35 72 L185 72 L168 188 L52 188 Z" fill="url(#redBody)" stroke="rgba(0,0,0,.15)" stroke-width="2"/>
          <line x1="46" y1="105" x2="174" y2="105" stroke="rgba(255,255,255,.25)" stroke-width="3"/>
          <line x1="49" y1="140" x2="171" y2="140" stroke="rgba(255,255,255,.2)" stroke-width="3"/>
          <ellipse cx="110" cy="185" rx="58" ry="10" fill="rgba(0,0,0,.15)"/>
          <ellipse cx="30" cy="78" rx="12" ry="18" fill="none" stroke="var(--red-a)" stroke-width="9"/>
          <ellipse cx="190" cy="78" rx="12" ry="18" fill="none" stroke="var(--red-a)" stroke-width="9"/>
          <ellipse cx="110" cy="72" rx="76" ry="15" fill="#e2493d" stroke="rgba(0,0,0,.18)" stroke-width="2"/>
          <ellipse cx="110" cy="72" rx="66" ry="10" fill="#c73a2f"/>
        </svg>
        <div class="binlabel">Antibiotics<br>Use as Directed<br>(ยาปฏิชีวนะ)</div>
      </div>
    </div>

    <div class="centercol">
      <div class="card" id="activeCard">
        <div class="blister" id="blisterGrid">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="name" id="cardName">Amoxicillin 500mg</div>
        <div class="namesub" id="cardSub">(ยาฆ่าเชื้อ)</div>
      </div>

      <div class="deck" id="deckBtn">
        <div class="layer"></div>
        <div class="layer"></div>
        <div class="layer">Draw</div>
      </div>
    </div>

    <div class="binwrap" id="binGreen" data-type="relief">
      <div class="bubble green">Symptom Relief – Use as Needed<br>(ยาบรรเทาอาการ – ใช้เมื่อจำเป็น)</div>
      <div style="position:relative;width:100%;">
        <svg class="bin" viewBox="0 0 220 200">
          <defs>
            <linearGradient id="greenBody" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="var(--green-a)"/>
              <stop offset="1" stop-color="var(--green-b)"/>
            </linearGradient>
          </defs>
          <path d="M35 72 L185 72 L168 188 L52 188 Z" fill="url(#greenBody)" stroke="rgba(0,0,0,.15)" stroke-width="2"/>
          <line x1="46" y1="105" x2="174" y2="105" stroke="rgba(255,255,255,.25)" stroke-width="3"/>
          <line x1="49" y1="140" x2="171" y2="140" stroke="rgba(255,255,255,.2)" stroke-width="3"/>
          <ellipse cx="110" cy="185" rx="58" ry="10" fill="rgba(0,0,0,.15)"/>
          <ellipse cx="30" cy="78" rx="12" ry="18" fill="none" stroke="var(--green-a)" stroke-width="9"/>
          <ellipse cx="190" cy="78" rx="12" ry="18" fill="none" stroke="var(--green-a)" stroke-width="9"/>
          <ellipse cx="110" cy="72" rx="76" ry="15" fill="#69b854" stroke="rgba(0,0,0,.18)" stroke-width="2"/>
          <ellipse cx="110" cy="72" rx="66" ry="10" fill="#438033"/>
        </svg>
        <div class="binlabel">Symptom Relief<br>Use as Needed<br>(บรรเทาอาการ)</div>
      </div>
    </div>

    <div class="flash" id="flash"></div>
  </div>

  <div class="footer">
    <button class="nextbtn" id="nextBtn">Next Item</button>
    <div class="scoretext">Score: <span id="scoreVal">0</span></div>
    <div class="progress"><div class="progress-fill" id="progressFill"></div></div>
  </div>

  <div class="complete" id="completeOverlay">
    <div class="complete-card">
      <h2>All Sorted! (จัดยาครบทุกใบแล้ว!)</h2>
      <p>Final Score: <strong id="finalScore">0</strong> / <span id="finalTotal">0</span> (คะแนนรวม) — ask each participant to explain their choice before revealing the answer</p>
      <button id="playAgainBtn">Play Again (เล่นอีกครั้ง)</button>
    </div>
  </div>
</div>

<script>
const items = [
  {name:"Amoxicillin 500mg", sub:"ยาฆ่าเชื้อ", type:"antibiotic"},
  {name:"Paracetamol 500mg", sub:"ยาลดไข้ / แก้ปวด", type:"relief"},
  {name:"Co-amoxiclav (Augmentin)", sub:"ยาฆ่าเชื้อสูตรผสม", type:"antibiotic"},
  {name:"Loratadine 10mg", sub:"ยาแก้แพ้", type:"relief"},
  {name:"Doxycycline 100mg", sub:"ยาฆ่าเชื้อ", type:"antibiotic"},
  {name:"Oral Rehydration Salts", sub:"ผงเกลือแร่", type:"relief"},
  {name:"Dextromethorphan", sub:"ยาแก้ไอ", type:"relief"},
  {name:"Ciprofloxacin 500mg", sub:"ยาฆ่าเชื้อ", type:"antibiotic"},
  {name:"Antacid", sub:"ยาลดกรด", type:"relief"},
  {name:"Azithromycin 250mg", sub:"ยาฆ่าเชื้อ", type:"antibiotic"},
  {name:"Ibuprofen 400mg", sub:"ยาแก้ปวด / ลดไข้", type:"relief"},
  {name:"Cephalexin 500mg", sub:"ยาฆ่าเชื้อ", type:"antibiotic"}
];

let deck = [];
let score = 0;
let doneCount = 0;
let current = null;
let armed = false;

const activeCard = document.getElementById('activeCard');
const cardName = document.getElementById('cardName');
const cardSub = document.getElementById('cardSub');
const binRed = document.getElementById('binRed');
const binGreen = document.getElementById('binGreen');
const scoreVal = document.getElementById('scoreVal');
const progressFill = document.getElementById('progressFill');
const flash = document.getElementById('flash');
const deckBtn = document.getElementById('deckBtn');
const nextBtn = document.getElementById('nextBtn');
const completeOverlay = document.getElementById('completeOverlay');
const playAgainBtn = document.getElementById('playAgainBtn');
const finalScore = document.getElementById('finalScore');
const finalTotal = document.getElementById('finalTotal');
const playarea = document.getElementById('playarea');

function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]]=[a[j],a[i]];
  }
  return a;
}

function startGame(){
  deck = shuffle(items);
  score = 0;
  doneCount = 0;
  scoreVal.textContent = score;
  progressFill.style.width = '0%';
  completeOverlay.classList.remove('show');
  drawNext();
}

function drawNext(){
  if(deck.length === 0){
    current = null;
    activeCard.style.visibility = 'hidden';
    finalScore.textContent = score;
    finalTotal.textContent = items.length;
    completeOverlay.classList.add('show');
    return;
  }
  current = deck.pop();
  cardName.textContent = current.name;
  cardSub.textContent = '(' + current.sub + ')';
  activeCard.style.visibility = 'visible';
  activeCard.style.transform = '';
  activeCard.classList.remove('armed');
  armed = false;
}

function showFlash(isCorrect){
  flash.textContent = isCorrect ? '✓' : '✕';
  flash.className = 'flash show ' + (isCorrect ? 'correct' : 'wrong');
  setTimeout(() => { flash.className = 'flash'; }, 550);
}

function resolveDrop(chosenType){
  if(!current) return;
  const isCorrect = current.type === chosenType;
  if(isCorrect) score++;
  doneCount++;
  scoreVal.textContent = score;
  progressFill.style.width = Math.round((doneCount/items.length)*100) + '%';
  showFlash(isCorrect);
  setTimeout(drawNext, 480);
}

/* --- drag logic (pointer events) --- */
let dragging = false;
let startX=0, startY=0, origX=0, origY=0;

activeCard.addEventListener('pointerdown', (e) => {
  if(!current) return;
  dragging = true;
  activeCard.setPointerCapture(e.pointerId);
  activeCard.classList.add('dragging');
  startX = e.clientX; startY = e.clientY;
  origX = 0; origY = 0;
});

activeCard.addEventListener('pointermove', (e) => {
  if(!dragging) return;
  const dx = e.clientX - startX;
  const dy = e.clientY - startY;
  activeCard.style.transform = `translate(${dx}px, ${dy}px) scale(1.05)`;
  checkHover(e.clientX, e.clientY);
});

function checkHover(x, y){
  const r1 = binRed.getBoundingClientRect();
  const r2 = binGreen.getBoundingClientRect();
  const overRed = x >= r1.left && x <= r1.right && y >= r1.top && y <= r1.bottom;
  const overGreen = x >= r2.left && x <= r2.right && y >= r2.top && y <= r2.bottom;
  binRed.classList.toggle('hover', overRed);
  binGreen.classList.toggle('hover', overGreen);
}

activeCard.addEventListener('pointerup', (e) => {
  if(!dragging) return;
  dragging = false;
  activeCard.classList.remove('dragging');
  binRed.classList.remove('hover');
  binGreen.classList.remove('hover');
  const r1 = binRed.getBoundingClientRect();
  const r2 = binGreen.getBoundingClientRect();
  const x = e.clientX, y = e.clientY;
  const overRed = x >= r1.left && x <= r1.right && y >= r1.top && y <= r1.bottom;
  const overGreen = x >= r2.left && x <= r2.right && y >= r2.top && y <= r2.bottom;

  const moved = Math.abs(e.clientX - startX) > 6 || Math.abs(e.clientY - startY) > 6;

  if(overRed){
    resolveDrop('antibiotic');
  } else if(overGreen){
    resolveDrop('relief');
  } else if(!moved){
    /* tap = arm/disarm for tap-to-place fallback */
    armed = !armed;
    activeCard.classList.toggle('armed', armed);
  } else {
    activeCard.style.transform = '';
  }
});

/* tap-to-place fallback on bins when card is armed */
binRed.addEventListener('click', () => { if(armed) resolveDrop('antibiotic'); });
binGreen.addEventListener('click', () => { if(armed) resolveDrop('relief'); });

deckBtn.addEventListener('click', () => { if(!current) drawNext(); });
nextBtn.addEventListener('click', () => { if(current) drawNext(); });
playAgainBtn.addEventListener('click', startGame);

startGame();
</script>
</body>
</html>
